# Production Environment Configuration for Maple Key Music Academy
# Copy this file to env.prod and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL database settings for production
POSTGRES_DB=maple_key_prod
POSTGRES_USER=maple_key_user
POSTGRES_PASSWORD=your_secure_production_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# =============================================================================
# DJANGO CONFIGURATION
# =============================================================================
# Django settings for production
SECRET_KEY=your-secure-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Database URL for Django (alternative format)
DATABASE_URL=postgresql://maple_key_user:your_secure_production_password_here@db:5432/maple_key_prod

# =============================================================================
# DJANGO ALLAUTH CONFIGURATION
# =============================================================================
# Google OAuth settings (get these from Google Cloud Console)
GOOGLE_CLIENT_ID=your-production-google-client-id-here
GOOGLE_CLIENT_SECRET=your-production-google-client-secret-here

# Google API call timeout (seconds) — production default 10
GOOGLE_API_TIMEOUT=10

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Django uses this to build OAuth redirect URIs and password-reset links
FRONTEND_URL=https://your-domain.com

# Vite/React environment variables
VITE_API_URL=https://your-domain.com/api
VITE_APP_NAME=Maple Key Music Academy
VITE_APP_ENV=production

# =============================================================================
# PRODUCTION FLAGS
# =============================================================================
# Flags for production environment
USE_DOCKER=True
ENABLE_DEBUG_TOOLBAR=False
ENABLE_HOT_RELOADING=False

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Additional security settings for production
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True



# =============================================================================
# HELCIM PAYMENTS — REQUIRED, backend refuses to boot without all four
# =============================================================================
# Production values come from the PRODUCTION Helcim account (the developer
# test account is a separate account — its token/terminal/subdomain/verifier
# do NOT carry over). Dashboard: All Tools → Integrations → API Access Tokens
# and → Webhooks. The webhook verifier token is base64 — paste as-is.
# Register the webhook URL in Helcim as:
#   https://your-domain.com/api/billing/payment-callback/
HELCIM_API_TOKEN=your-production-helcim-api-token-here
HELCIM_TERMINAL_ID=your-production-terminal-id-here
HELCIM_WEBHOOK_SECRET=your-production-webhook-verifier-token-here
HELCIM_SUBDOMAIN=your-production-helcim-subdomain-here

# =============================================================================
# EMAIL (Resend) — REQUIRED for invoice/payment emails
# =============================================================================
# Without RESEND_API_KEY every payment-request email fails (recorded on the
# invoice as email_sent=False; recover via the Resend Email button).
RESEND_API_KEY=your-resend-api-key-here
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# =============================================================================
# MONITORING
# =============================================================================
# Grafana admin password (monitoring profile only)
# Generate a strong value with: openssl rand -base64 32
GF_SECURITY_ADMIN_PASSWORD=your-strong-grafana-password-here

# MAP-113: hide test-account data from analytics/financial metrics in prod
ANALYTICS_EXCLUDE_TEST_DATA=True
TEST_ACCOUNT_EMAIL_DOMAINS=maplekeytest.com
