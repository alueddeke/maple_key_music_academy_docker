# Production Environment — copy to env.prod and fill in values
# Store all secrets in 1Password and set as GitHub secrets for CI/CD

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_DB=maple_key_prod
POSTGRES_USER=maple_key_user
POSTGRES_PASSWORD=your_secure_production_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://maple_key_user:your_secure_production_password_here@db:5432/maple_key_prod

# =============================================================================
# DJANGO
# =============================================================================
SECRET_KEY=your-secure-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=maplekeymusic.com,www.maplekeymusic.com

# =============================================================================
# CORS / FRONTEND
# =============================================================================
CORS_ALLOWED_ORIGINS=https://maplekeymusic.com,https://www.maplekeymusic.com
FRONTEND_URL=https://maplekeymusic.com

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
GOOGLE_CLIENT_ID=your-production-google-client-id-here
GOOGLE_CLIENT_SECRET=your-production-google-client-secret-here

# =============================================================================
# EMAIL
# =============================================================================
RESEND_API_KEY=your-resend-api-key-here
DEFAULT_FROM_EMAIL=noreply@maplekeymusic.com

# =============================================================================
# MONITORING
# =============================================================================
# Generate with: openssl rand -base64 32
# Store in 1Password and set as GRAFANA_ADMIN_PASSWORD in GitHub secrets
GF_SECURITY_ADMIN_PASSWORD=your-strong-grafana-password-here
