# Non-secret production config for deploy-from-laptop.sh (copy to prod.config.env — gitignored).
# These are the GitHub Actions "secrets" that are plain configuration (SECRETS-INVENTORY.md:
# "not synced on purpose"). Values: `gh secret list` shows names only; read them from the running
# backend container (`docker inspect maple-key-backend`) or from MAP-190's DEPLOY-CONFIG table.
POSTGRES_USER=
POSTGRES_DB=
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
PLATFORM_ADMIN_EMAILS=
FRONTEND_URL=
DEFAULT_FROM_EMAIL=
HELCIM_SUBDOMAIN=
CERTBOT_EMAIL=
# Optional: deploy a specific image tag instead of :latest (e.g. a git sha pushed by 03-push.sh)
# IMAGE_TAG=
